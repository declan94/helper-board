#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Lark(海外版)自建应用凭据(创建步骤见 docs/lark-setup.md)
#define LARK_APP_ID "cli_xxxxxxxxxxxxxxxx"
#define LARK_APP_SECRET "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// 多维表格 Base:app_token 在表格 URL 中 (https://xxx.larksuite.com/base/<APP_TOKEN>?table=<TABLE_ID>)
#define LARK_BASE_APP_TOKEN "bascnxxxxxxxxxxxxxxxx"
#define LARK_TABLE_ID "tblxxxxxxxxxxxx"

// 表格字段名(与多维表格中的列名严格一致)
#define LARK_FIELD_DATE "日期"
#define LARK_FIELD_BREAKFAST "早餐"
#define LARK_FIELD_LUNCH "午餐"
#define LARK_FIELD_DINNER "晚餐"
#define LARK_FIELD_NOTE "备注"

// ===== 呼叫通道(ntfy)=====
// 公有服务器上 topic 名即密码,任何知道它的人都能让板子响铃。前缀只是给自己看的,
// 熵全靠后面的随机串,别省:
//   python3 -c "import secrets; print('helper-call-'+secrets.token_urlsafe(18))"
#define NTFY_BASE_URL "https://ntfy.sh"
#define NTFY_TOPIC_CALL "helper-call-xxxxxxxxxxxxxxxxxxxxxxxx"  // 你 → 板子:呼叫
#define NTFY_TOPIC_ACK "helper-ack-xxxxxxxxxxxxxxxxxxxxxxxxx"   // 板子 → 你:停铃回执
// 自建 ntfy 且开了鉴权时填访问令牌;用 ntfy.sh 公有服务器留空即可
#define NTFY_TOKEN ""
